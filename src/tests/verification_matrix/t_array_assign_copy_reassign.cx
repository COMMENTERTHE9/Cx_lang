// Reassignment over an already-initialised binding, and a `let` binding with no
// declared type — two forms distinct from the typed-declaration form above.
a: [3: t64] = [11, 22, 33]
b: [3: t64] = [1, 2, 3]
b = a
b:[1] = 99
print(a:[1])
print(b:[1])
let c
c = a
c:[2] = 88
print(a:[2])
print(c:[2])
