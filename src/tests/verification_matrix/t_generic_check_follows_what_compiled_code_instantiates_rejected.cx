// The per-call check of a generic body follows what compiled code
// instantiates. Here 256 calls to `f` with distinct types sit in `unused`,
// which nothing calls; they used to use up `f`'s budget, so the instance
// `g` reaches — `f` with T = f64, where 34 is a whole number beside a T
// element — was not checked. The interpreter stopped at run time and compiled
// code, which instantiates only `f<f64, ..>`, printed 34. Calls compiled
// code makes are now checked first, with no limit but one compiled code's
// own refusal stays below.
fnc: T <T, U, V, W> f(x: T, u: U, v: V, w: W) {
    c: [2: T] = [x, 34]
    return c:[1]
}
fnc: T <T> g(x: T) { return f(x, 0, 0, 0) }
