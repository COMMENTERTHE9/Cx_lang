// Arrays of different element types do not convert (owner's decision,
// 2026-10-24). Assigning a `[3: t8]` where a `[3: t64]` is declared was
// accepted unconverted: the interpreter kept the values, and compiled code read
// the 3 bytes of the t8 array as three t64s. Now a type mismatch.
xs: [3: t8] = [1, 2, 3]
ys: [3: t64] = xs
print(ys:[2])
