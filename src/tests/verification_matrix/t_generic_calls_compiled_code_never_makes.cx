fnc: t64 <T> nest(x: T, n: t64) {
    if n <= 0 { return 0 }
    return nest([x], n - 1)
}
fnc: t64 <T> demo(x: T) { return nest(5, 40) }
fnc: T <T> id(x: T) { return x }
fnc: Result<T> <T> fail(n: t64) {
    r: Result<T> = Err("no")
    return id(r)
}
fnc: t64 later() {
    return 1
    print(fail(1))
}
h: f64 = 1.5
print(f(h, 0))
print(later())
