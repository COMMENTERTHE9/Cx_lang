// Compound `/=` and `%=` by -1 on the minimum value. The interpreter wraps
// MIN / -1 to MIN and gives MIN % -1 = 0. On the JIT, compound assignment used
// a raw `sdiv`, which faults in hardware on exactly this input (Windows
// 0xC0000095, integer overflow) — for a variable, a struct field and an array
// element alike. Ordinary compound division is checked alongside.
struct P { x: t32 }
a: t32 = -2147483648
m: t32 = -1
a /= m
print(a)
p: P = P { x: -2147483648 }
p.x /= m
print(p.x)
arr: [2: t32] = [-2147483648, 7]
arr:[0] /= m
print(arr:[0])
c: t32 = -2147483648
c %= m
print(c)
d: t64 = 7
d /= 2
print(d)
d %= 2
print(d)
small: t8 = -128
n8: t8 = -1
small /= n8
print(small)
