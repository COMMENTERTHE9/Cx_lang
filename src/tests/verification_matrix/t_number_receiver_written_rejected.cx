// A receiver that is not a struct or an array is a value. A method that
// assigned one left the caller's variable at 105 on the interpreter, which
// wrote it back, and at 5 in compiled code, which never has.
struct V { x: t64 }
num: impl (p: V, k: t64) {
    fnc: t64 grow(by: t64) {
        k += 100
        p.x += by
        return k
    }
}
q: V = V { x: 1 }
n: t64 = 5
print(q.grow(n, 1))
print(n)
