// A whole-number literal written where a `Result`'s payload type is declared
// has that type, and is range-checked against it — at a declaration, in an
// argument, in a `return`. A Result made that way can then be read at a type
// at least as wide. (The reverse — a Result of a wider or an undeclared width
// read at a narrower type — is rejected by analysis; see the
// `t_result_*_rejected` fixtures.)
fnc: t64 take8(p: Result<t8>) { print(p); return 0 }
fnc: Result<t8> smallest() { return Ok(-128) }
fnc: Result<t64> run() {
    a: Result<t8> = Ok(127)
    print(a?)
    b: Result<t16> = Ok(20000)
    print(b?)
    c: Result<t8> = Ok(-3)
    print(c?)
    print(take8(Ok(12)))
    print(smallest())

    // An untyped variable holding a literal is a number of no declared width,
    // which is as wide as a t64.
    let u
    u = Ok(12)
    wide: Result<t64> = u
    print(wide)

    // A narrow Result read wider.
    wider: Result<t64> = a
    print(wider)
    return Ok(0)
}
print(run())
