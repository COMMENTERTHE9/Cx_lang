// Inside a generic function a type parameter is a type of its own. What a
// body does with `T` values only — bind, assign, pass, return, put in an
// array, wrap in a Result — is right for every `T`, and is the same on both
// backends for numbers, strings, arrays, structs and Results.
struct P { x: t64, y: t64 }
fnc: T <T> id(x: T) { return x }
fnc: T <T> twice(x: T) { return id(id(x)) }
fnc: T <T> keep(x: T) {
    y: T = x
    y = x
    return y
}
fnc: T <T> pick(c: bool, a: T, b: T) {
    return if c { a } else { b }
}
fnc: [2: T] <T> pair(x: T) { return [x, x] }
fnc: Result<T> <T> wrap(x: T) { return Ok(x) }
fnc: Result<T> <T> fail(x: T) { return Err("no") }
fnc: Result<T> <T> pass(r: Result<T>) {
    v: T = r?
    return Ok(v)
}
a: t8 = 5
w: t64 = 300
print(twice(a))
print(keep(w))
print(pick(true, a, 9))
print(keep("text"))
print(pick(false, "one", "two"))
xs: [2: t64] = pair(w)
print(xs:[1])
names: [2: str] = pair("n")
print(names:[0])
ys: [3: t8] = [1, 2, 3]
zs: [3: t8] = keep(ys)
print(zs:[2])
p: P = P { x: 1, y: 2 }
q: P = keep(p)
print(q.y)
print(wrap(a))
print(wrap("s"))
print(fail(a))
r: Result<t64> = Ok(7)
print(pass(r))
e: Result<t64> = Err("gone")
print(pass(e))
