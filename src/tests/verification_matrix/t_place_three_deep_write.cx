// Rank 3 write through the same folded suffix. Non-square 2x3x4, asymmetric
// values, and every element of the touched row asserted so a write landing at
// the wrong offset shows up rather than hiding behind a plausible number.
c: [2: [3: [4: t64]]] = [
    [[0, 1, 2, 3], [10, 11, 12, 13], [20, 21, 22, 23]],
    [[100, 101, 102, 103], [110, 111, 112, 113], [120, 121, 122, 123]]
]
c:[1]:[2]:[0] = 777
c:[0]:[0]:[3] = 888
print(c:[1]:[2]:[0])
print(c:[1]:[2]:[1])
print(c:[1]:[2]:[2])
print(c:[1]:[2]:[3])
print(c:[0]:[0]:[0])
print(c:[0]:[0]:[3])
print(c:[1]:[1]:[0])
