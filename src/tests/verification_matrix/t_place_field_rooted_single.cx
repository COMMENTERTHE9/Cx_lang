// The one-dimensional case of the same shape: a single index rooted at a field.
// Kept separate so a fix that only works once the chain is longer than one
// cannot pass.
struct H { arr: [3: t8], tag: t64 }
let h;
h = H { arr: [1, 2, 3], tag: 5 }
h.arr:[1] = 9
print(h.arr:[0])
print(h.arr:[1])
print(h.arr:[2])
print(h.tag)
