// A number literal beside a `T` element is accepted by analysis for every
// `T`. When the function is called with a `t8`, 349 does not fit the element:
// compiled code used to narrow it on the way into the array and print 93,
// with exit 0, where the interpreter prints 349. Compiled code now refuses
// the program. This fixture pins the interpreter's answer, which is not a
// `t8` either: whether a concrete value may stand where a type parameter is
// declared is an open question for analysis (known-issues §74).
fnc: T <T> second(x: T) {
    c: [2: T] = [x, 349]
    return c:[1]
}
a: t8 = 5
print(second(a))
