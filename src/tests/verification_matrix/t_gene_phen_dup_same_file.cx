// 0.3.4 slice 1: exact duplicate — two phens binding the same gene to the
// same concrete type, in the same file. Must be rejected with the design
// doc's exact two-location diagnostic.
gene Merge2 {
    fnc add(rhs: Self) -> Self
}

phen Merge2 (v: t32) {
    fnc: t32 add(rhs: t32) {
        v + rhs
    }
}

phen Merge2 (v: t32) {
    fnc: t32 add(rhs: t32) {
        v + rhs
    }
}

print(1)
