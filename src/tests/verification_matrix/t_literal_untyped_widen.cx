// An untyped array literal is typed by its element[0], widened by any later
// typed element that is wider. `[a, b]` with `a: t8` and `b: t64` used to be a
// `[2: t8]`: the JIT stored 300 in a t8 slot (44) while the interpreter kept it,
// and `[1, f]` with an f64 `f` put 2.5 into an integer slot on the JIT. Nothing
// else changes — a literal never decides the width, so `[1, a]` and `[a, 1]`
// keep the types they had (their sums print 200 and -56 as before).
a: t8 = 5
b: t64 = 300
let ys;
ys = [a, b]
print(ys:[1])
f: f64 = 2.5
let fs;
fs = [1, f]
if fs:[1] > 2.0 {
    print(1)
} else {
    print(0)
}
h: t8 = 100
let lit_first;
lit_first = [1, h]
print(lit_first:[1] + lit_first:[1])
let typed_first;
typed_first = [h, 1]
z: t8 = typed_first:[0] + typed_first:[0]
print(z)
