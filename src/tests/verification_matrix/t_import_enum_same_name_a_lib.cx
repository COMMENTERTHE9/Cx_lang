// One of two libraries that each declare `enum Color`, with different variant
// orders, for t_import_enum_same_name.
enum Color { Red, Green }

pub fnc: Color red() {
    Color::Red
}

pub fnc: t32 code(c: Color) {
    when c {
        Color::Red => 10,
        Color::Green => 20,
        _ => 0,
    }
}
