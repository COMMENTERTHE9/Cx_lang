// Specialization must retain enum identity at every typed boundary.
enum Phase { Idle, Active }
phase: Phase = Phase::Idle
fnc: Phase current() { phase }
n: t8 = 1
struct Holder { value: Phase }
fnc: t64 <T> set_phase(value: T) { h: Holder = Holder { value: value }; phase = h.value; 0 }
print(set_phase(n))
print(current())
