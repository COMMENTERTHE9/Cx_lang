// Library with fixed-array parameters of narrow element types. Each function
// reads a non-zero index, where an element-width mismatch shows up.
pub fnc: t32 asum(a: [3: t32]) {
    a:[0] + a:[1] * 10 + a:[2] * 100
}

pub fnc: t16 asecond(a: [2: t16]) {
    a:[1]
}

pub fnc: t8 athird(a: [3: t8]) {
    a:[2]
}
