// The same for a `Result` receiver: the interpreter wrote `Ok(99)` back to
// `res`, compiled code left it `Ok(5)`.
struct V { x: t64 }
rm: impl (p: V, r: Result<t64>) {
    fnc: t64 set() {
        r = Ok(99)
        return 1
    }
}
q: V = V { x: 1 }
res: Result<t64> = Ok(5)
print(q.set(res))
print(res)
