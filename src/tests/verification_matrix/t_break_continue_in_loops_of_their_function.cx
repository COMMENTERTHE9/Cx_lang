// `break` and `continue` refer to a loop of the function they are written in:
// the innermost one, or the one with their label. A function called from a
// loop, or declared inside one, has its own loops — and may reuse a label.
fnc: t64 first_over(limit: t64) {
    n: t64 = 0
    loop {
        n = n + 3
        if n > limit { break }
    }
    return n
}

fnc: t64 count_odd(upto: t64) {
    odd: t64 = 0
    for i in 0..upto {
        if i % 2 == 0 { continue }
        odd = odd + 1
    }
    return odd
}

struct Grid { hits: t64 }
gm: impl (g: Grid) {
    fnc: t64 scan(rows: t64, cols: t64) {
        'rows: for r in 0..rows {
            for c in 0..cols {
                if c > r { continue 'rows }
                if r == 3 { break 'rows }
                g.hits += 1
            }
        }
        return g.hits
    }
}

total: t64 = 0
i: t64 = 0
'outer: while (i < 4) {
    i = i + 1
    // Declared inside a labeled loop: its own loop may carry the same label,
    // and its `break` ends that loop, not the one around the declaration.
    fnc: t64 inner(k: t64) {
        n: t64 = 0
        'outer: loop {
            n = n + 1
            if n >= k { break 'outer }
        }
        return n
    }
    total = total + inner(i) + first_over(i) + count_odd(i)
    if i == 3 { continue 'outer }
    print(total)
}
print(total)
board: Grid = Grid { hits: 0 }
print(board.scan(5, 4))
print(board.hits)
