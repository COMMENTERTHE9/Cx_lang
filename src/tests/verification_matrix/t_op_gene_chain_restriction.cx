// 0.3.4 slice 6: the interim restriction — operator-gene dispatch requires a
// named variable as the left operand; a chained (a + b) + c rejects with the
// explicit interim error, not a confusing fallback.
struct Vec2 { x: t32, y: t32 }
phen Add (v: Vec2) {
    fnc: Self add(rhs: Self) {
        made: Self = Vec2 { x: v.x + rhs.x, y: v.y + rhs.y }
        made
    }
}
let a;
let b;
let c;
a = Vec2 { x: 1, y: 2 }
b = Vec2 { x: 10, y: 20 }
c = Vec2 { x: 100, y: 200 }
let d;
d = (a + b) + c
print(d.x)
