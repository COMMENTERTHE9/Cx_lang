// 0.3.4 slice 6 introduced an interim restriction: operator-gene dispatch
// required a NAMED variable as the left operand, so `(a + b) + c` was rejected
// with an explicit error rather than a confusing fallback. This fixture pinned
// that rejection.
//
// The restriction is lifted. A non-variable left operand now travels as an
// expression receiver — a temporary, evaluated in place, with no write-back —
// so the chain evaluates. The fixture is kept at the same shape it always had,
// with its expectation converted from "rejects" to the value it produces, so
// the history of what the restriction was and what replaced it stays visible.
struct Vec2 { x: t32, y: t32 }
phen Add (v: Vec2) {
    fnc: Self add(rhs: Self) {
        made: Self = Vec2 { x: v.x + rhs.x, y: v.y + rhs.y }
        made
    }
}
let a;
let b;
let c;
a = Vec2 { x: 1, y: 2 }
b = Vec2 { x: 10, y: 20 }
c = Vec2 { x: 100, y: 200 }
let d;
d = (a + b) + c
print(d.x)
