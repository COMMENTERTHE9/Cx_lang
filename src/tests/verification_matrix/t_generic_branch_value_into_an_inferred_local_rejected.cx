// A variable known only by inference holds a `T` here, and an if value
// assigned to it later is checked against that: its second branch is a number
// literal. The interpreter used to return 300 from a call whose `T` is a t8;
// compiled code refused.
fnc: T <T> f(c: bool, x: T) {
    let y
    y = x
    y = if c { x } else { 300 }
    return y
}
a: t8 = 5
print(f(false, a))
