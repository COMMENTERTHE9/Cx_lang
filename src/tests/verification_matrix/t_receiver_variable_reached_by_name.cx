// While a method runs, its receiver's variable is reached only through the
// receiver. Here `run` is called on the top-level `top` and calls `poke`,
// which changes `top` by its own name. The interpreter runs a method on a
// copy of its receiver and stores it back at the end, so `poke` read `top`
// as it was before the call, and its write was then overwritten: this
// program printed 1001, then 111. Neither is a defined result. Analysis
// rejects the call: `run`, or something it calls, names the variable it is
// called on (owner's decision of 2026-11-20; before it the interpreter
// stopped at run time and compiled code refused the program).
struct V { x: t64 }
top: V = V { x: 1 }
fnc: t64 poke() {
    top.x += 1000
    return top.x
}
vm: impl (s: V) {
    fnc: t64 run() {
        s.x += 10
        r: t64 = poke()
        s.x += 100
        return r
    }
}
print(top.run())
print(top.x)
