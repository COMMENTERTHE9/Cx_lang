// A `.copy` argument is passed by address and written back, so it must have
// the parameter's type: a `[3: t8]` given to a `[3: t64]` `.copy` parameter was
// read as three t64s by compiled code, and written back as 24 bytes into its 3.
fnc: t64 shift(r.copy: [3: t64]) {
    r:[0] += 100
    return r:[2]
}
xs: [3: t8] = [1, 2, 3]
print(shift(xs.copy))
