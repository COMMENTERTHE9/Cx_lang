// A variable that takes a `T` value is a `T`, and a string is not one. Before
// analysis checked that, the string assignment in the branch that never runs
// made compiled code's whole-function metadata read the array printed above
// it as a string; it had to refuse the program.
fnc: t32 <T> show(value: T) {
    let x;
    x = value
    printn("{x}")
    if false { x = "later" }
    0
}
a: [2: t64] = [1, 2]
print(show(a))
