// Element width drives the stride: 3x4 of t8 is 12 contiguous bytes, and a plan
// that assumed 8-byte elements would read garbage. Non-square, asymmetric, every
// element asserted.
m: [3: [4: t8]] = [[1, 2, 3, 4], [11, 12, 13, 14], [21, 22, 23, 24]]
print(m:[0]:[0])
print(m:[0]:[3])
print(m:[1]:[0])
print(m:[1]:[3])
print(m:[2]:[0])
print(m:[2]:[3])
m:[1]:[2] = 99
print(m:[1]:[1])
print(m:[1]:[2])
print(m:[1]:[3])
