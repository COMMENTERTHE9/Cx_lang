struct Pair { x: t64, data: [2: t8] }
fnc: t64 run() {
    n: t64 = 7
    yes: bool = true
    text: str = "bundle"
    pair: Pair = Pair { x: 9, data: [3, 4] }
    fnc: t64 inspect_bundle(t: copy_into(n, yes, text, pair)) {
        print(t.yes)
        print(t.text)
        p: Pair = t.pair
        p.data:[0] = 99
        t.n = t.n + 10
        t.n + p.x
    }
    print(inspect_bundle(copy_into(n, yes, text, pair)))
    print(n)
    print(pair.data:[0])
    n
}
print(run())
