// 0.3.4 slice 1: a valid gene + one valid phen, never used. Both are inert —
// parsing and registering them must not change the program's behavior at all.
struct Player { health: t32 }

gene Damageable {
    fnc take_damage(amount: t32)
    fnc is_alive() -> bool
}

phen Damageable (p: Player) {
    fnc: take_damage(amount: t32) {
        p.health -= amount
    }
    fnc: bool is_alive() {
        p.health > 0
    }
}

print(42)
