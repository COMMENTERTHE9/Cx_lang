// An impl's extra receivers are passed by reference, so an argument must have
// the receiver's declared type: a `[3: t8]` given for a `[3: t64]` receiver was
// read at t64 width by compiled code.
struct P { n: t64 }
pm: impl (p: P, v: [3: t64]) {
    fnc: t64 total() {
        v:[0] + v:[1] + v:[2]
    }
}
let q
q = P { n: 1 }
xs: [3: t8] = [1, 2, 3]
print(q.total(xs))
